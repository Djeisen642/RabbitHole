{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "abbit-hole",
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's r/abbitHole puzzle",
        "description": "Creates the daily guess-the-subreddit post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Pick today's r/abbitHole puzzle",
        "description": "Picks today's and tomorrow's puzzles now if they are missing",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/pick-puzzle"
      },
      {
        "label": "Check r/abbitHole pool",
        "description": "Checks every pool community; results at /api/pool-check",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/check-pool"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "scheduler": {
    "tasks": {
      "daily-pick": {
        "endpoint": "/internal/scheduler/daily-pick",
        "cron": "0 5 * * *"
      },
      "pool-check": {
        "endpoint": "/internal/scheduler/pool-check"
      }
    }
  }
}
